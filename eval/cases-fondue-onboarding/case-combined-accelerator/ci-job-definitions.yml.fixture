# Minimal fixture with the same matrix shape as the Fondue root configuration.
rhai_pipeline:
  torch_versions:
    "2.6": {builder_collection: "torch-2.6.0"}
  variants:
    cpu-ubi9:
      arches: [x86_64]
      torch_versions: ["2.6"]
    cuda12.9-ubi9:
      arches: [x86_64]
      torch_versions: ["2.6"]
    rocm7.14-ubi9:
      arches: [x86_64]
      torch_versions: ["2.6"]
  collections:
    onboarding:
      variants: [cpu-ubi9, cuda12.9-ubi9, rocm7.14-ubi9]
