# Sandbox-compatible Fondue validation fixture.
.PHONY: regen linter-sandbox linter-mr linter
regen:
	@if [ -d builder ]; then touch .gitlab-triggers.yaml; fi
linter-sandbox: regen
	@echo "Sandbox checks passed"
linter-mr: linter-sandbox
	@git diff --cached --quiet || { echo "Commit staged changes first"; exit 1; }
	@echo "MR checks passed"
linter:
	@echo "Full linter requires capabilities unavailable in the agent sandbox"; exit 1
